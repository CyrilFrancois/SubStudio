# SubStudio settings. Docker: copy to .env (gitignored, never commit a real key). Natively, the backend does not
# read this file: set the same variables in its terminal (readme « Run it natively »), and NEXT_PUBLIC_API_URL in
# frontend/.env.local. Every value below is a default or an example; none is a secret.

# --- Library and local state ---------------------------------------------------------------------------------
# The folder holding your videos. Docker mounts NEXT_PUBLIC_MEDIA_PATH at /data, so leave this at /data there;
# natively set it to the folder itself, e.g. C:/Videos (forward slashes).
SUBSTUDIO_MEDIA_ROOT=/data
# SubStudio's own files (settings, the job queue jobs.sqlite3, context cache). Default: backend/state. Never inside
# the library.
# SUBSTUDIO_STATE_DIR=
# Per-video intermediate files. Default: <system temp>/SubStudio/work.
# SUBSTUDIO_WORK_DIR=
# 0 = no online lookup at all: subtitle sites and TVmaze (offline runs, tests). Default: 1.
# SUBSTUDIO_DOWNLOADS=1
# 1 = simulated jobs so the new UI can be tried without processing anything (the UI shows a banner).
# SUBSTUDIO_API_STUB=

# --- Transcription (local) -------------------------------------------------------------------------------------
# faster-whisper model; downloaded once (~1.6 GB for turbo).
# WHISPER_MODEL=turbo
# CPU threads for transcription; the budget is 4 (half of a 4-core / 8-thread laptop, D-0001).
# ASR_THREADS=4

# --- Translation -----------------------------------------------------------------------------------------------
# `local` (default: free, on this PC, D-0001/D-0003) or `gemini` (cloud, opt-in). Under Docker only `gemini` works:
# the Linux container cannot run the Windows llama-server.exe.
# TRANSLATOR=local
# The local backend's files; defaults under %LOCALAPPDATA%\SubStudio\ (readme « Once: the local translator »):
# llama.cpp b12532 Vulkan build (https://github.com/ggml-org/llama.cpp/releases/tag/b12532) and
# TranslateGemma 4B Q4_K_M (https://huggingface.co/bullerwins/translategemma-4b-it-GGUF).
# LLAMA_SERVER_BIN=C:/Users/<you>/AppData/Local/SubStudio/llama.cpp/b12532-vulkan/llama-server.exe
# LLAMA_MODEL_PATH=C:/Users/<you>/AppData/Local/SubStudio/models/translategemma-4b-it-Q4_K_M.gguf
# Layers on the integrated GPU; 0 = CPU only (4 threads either way).
# LLAMA_GPU_LAYERS=99
# LLAMA_PORT=8092

# Only with TRANSLATOR=gemini: Gemini receives the subtitle text to translate. Key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# Must be a Gemini 3.x model (the request sends thinkingLevel).
# GEMINI_MODEL=gemini-3.8-flash

# --- Optional services -----------------------------------------------------------------------------------------

# A free OpenSubtitles.com account (https://www.opensubtitles.com/en/users/sign_up): adds the largest catalogue and
# exact-file matches to the downloads. Without it, only the keyless providers are asked.
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# --- Frontend ----------------------------------------------------------------------------------------------------
# Where the frontend finds the backend, applied when `npm run dev` starts. Natively, put it in frontend/.env.local.
# Under Docker it is fixed to http://localhost:8000 by docker-compose.yml, so this line is not used there.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Docker only: the host folder mounted into the backend as /data. Windows: forward slashes.
NEXT_PUBLIC_MEDIA_PATH=C:/Videos

# Old dashboard (/legacy) only: the languages it offers, as label -> code (single-quoted JSON).
# The new UI keeps the wanted languages in Settings instead.
# NEXT_PUBLIC_LANGUAGES='{"English":"en", "French":"fr", "Spanish":"es", "German":"de"}'
