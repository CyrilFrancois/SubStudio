# Copy to .env and fill in. .env is gitignored — never commit a real key.

# OPTIONAL — translation backend: `local` (default: free, on this PC, D-0001/D-0003) or `gemini` (cloud, opt-in).
# TRANSLATOR=local

# OPTIONAL — the local backend's files. Defaults (Windows, native run) under %LOCALAPPDATA%\SubStudio\:
# llama.cpp b12532 Vulkan build (https://github.com/ggml-org/llama.cpp/releases/tag/b12532) and
# TranslateGemma 4B Q4_K_M (https://huggingface.co/bullerwins/translategemma-4b-it-GGUF).
# LLAMA_SERVER_BIN=C:/Users/<you>/AppData/Local/SubStudio/llama.cpp/b12532-vulkan/llama-server.exe
# LLAMA_MODEL_PATH=C:/Users/<you>/AppData/Local/SubStudio/models/translategemma-4b-it-Q4_K_M.gguf
# LLAMA_GPU_LAYERS=99   (layers on the integrated GPU; 0 = CPU only, 4 threads either way)
# LLAMA_PORT=8092

# Only with TRANSLATOR=gemini — Gemini API key (https://aistudio.google.com/apikey).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash   (must be a Gemini 3.x model: the request sends thinkingLevel)

# OPTIONAL — a free OpenSubtitles.com account (https://www.opensubtitles.com/en/users/sign_up). With it, the
# subtitle download step (core/acquire) adds the largest catalogue and exact-file (moviehash) matches; without it,
# only the keyless providers are asked. Free accounts get a small daily download quota.
# OPENSUBTITLES_USERNAME=
# OPENSUBTITLES_PASSWORD=

# REQUIRED — host folder holding your videos. Mounted into the backend container as /data.
# Windows: use forward slashes, e.g. C:/Videos
NEXT_PUBLIC_MEDIA_PATH=C:/Videos

# REQUIRED — backend base URL. NEXT_PUBLIC_* is baked in at BUILD time: after changing this you
# must `docker compose down && docker compose up --build`, not just restart.
NEXT_PUBLIC_API_URL=http://localhost:8000

# REQUIRED — languages offered in the sidebar's OUT dropdown, as a JSON object of label -> code.
# Read by frontend/src/components/layout/Sidebar.tsx. Must be single-quoted.
NEXT_PUBLIC_LANGUAGES='{"English":"en", "French":"fr", "Spanish":"es", "German":"de", "Japanese":"ja", "Italian":"it", "Portuguese":"pt", "Korean": "ko", "Chinese": "zh"}'
