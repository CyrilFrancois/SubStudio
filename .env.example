# SubStudio settings. Docker: copy to .env (gitignored, never commit a real key). Natively, the backend does not
# read this file: set the same variables in its terminal (readme « Run it natively »), and NEXT_PUBLIC_API_URL in
# frontend/.env.local. Every value below is a default or an example; none is a secret.

# --- Library and local state ---------------------------------------------------------------------------------
# The folder holding your videos. Docker mounts NEXT_PUBLIC_MEDIA_PATH at /data, so leave this at /data there;
# natively set it to the folder itself, e.g. C:/Videos (forward slashes).
SUBSTUDIO_MEDIA_ROOT=/data
# SubStudio's own small files (settings, context cache). Default: backend/state. Never inside the library.
# SUBSTUDIO_STATE_DIR=
# Per-video intermediate files. Default: <system temp>/SubStudio/work.
# SUBSTUDIO_WORK_DIR=
# 0 = never ask subtitle sites over the network (offline runs, tests). Default: 1.
# SUBSTUDIO_DOWNLOADS=1
# 1 = simulated jobs so the new UI can be tried without processing anything (the UI shows a banner).
# SUBSTUDIO_API_STUB=

# --- Transcription (local) -------------------------------------------------------------------------------------
# faster-whisper model; downloaded once (~1.6 GB for turbo).
# WHISPER_MODEL=turbo
# CPU threads for transcription; the budget is 4 (half of a 4-core / 8-thread laptop, D-0001).
# ASR_THREADS=4

# --- Optional services -----------------------------------------------------------------------------------------
# Cloud translation, used only until the local translator lands (D-0003). Empty = no subtitle text leaves the
# computer for translation; languages that need translating then fail with that reason.
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Must be a Gemini 3.x model (the request sends thinkingLevel).
# GEMINI_MODEL=gemini-3.8-flash

# A free OpenSubtitles.com account (https://www.opensubtitles.com/en/users/sign_up): adds the largest catalogue and
# exact-file matches to the downloads. Without it, only the keyless providers are asked.
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# --- Frontend ----------------------------------------------------------------------------------------------------
# Where the frontend finds the backend. NEXT_PUBLIC_* values are applied when the frontend starts
# (`npm run dev`) or when its Docker image is built (`docker compose up --build`).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Docker only: the host folder mounted into the backend as /data. Windows: forward slashes.
NEXT_PUBLIC_MEDIA_PATH=C:/Videos

# Old dashboard (/legacy) only: the languages it offers, as label -> code (single-quoted JSON).
# The new UI keeps the wanted languages in Settings instead.
# NEXT_PUBLIC_LANGUAGES='{"English":"en", "French":"fr", "Spanish":"es", "German":"de"}'
